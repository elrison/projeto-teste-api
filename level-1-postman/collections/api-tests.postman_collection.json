{
  "info": {
    "name": "Petstore - Testes de API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar pets disponiveis",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet/findByStatus?status=available",
          "host": ["{{baseUrl}}"],
          "path": ["pet", "findByStatus"],
          "query": [{"key": "status", "value": "available"}]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Resposta e uma lista de pets\", function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Criar pet de teste",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{petId}},\n  \"name\": \"pet-teste-newman\",\n  \"photoUrls\": [\"https://example.com/pet.jpg\"],\n  \"status\": \"available\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pet",
          "host": ["{{baseUrl}}"],
          "path": ["pet"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"petId\", Date.now().toString());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.environment.set(\"petId\", pm.response.json().id.toString());"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Consultar pet por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet", "{{petId}}"]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test(\"Status code is 200\", function () {",
            "    pm.response.to.have.status(200);",
            "});",
            "pm.test(\"Pet retornado possui ID e nome\", function () {",
            "    const pet = pm.response.json();",
            "    pm.expect(pet.id).to.eql(Number(pm.environment.get('petId')));",
            "    pm.expect(pet.name).to.be.a('string').and.not.empty;",
            "});"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "Pet inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet/{{invalidPetId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet", "{{invalidPetId}}"]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test(\"Status code is 404\", function () {",
            "    pm.response.to.have.status(404);",
            "});"
          ],
          "type": "text/javascript"
        }
      }]
    }
  ]
}
